{
  "app": {
    // 签名配置留空：签名材料（.p12 / .cer / .p7b）是本机私有的，不入库。
    // 在 DevEco Studio 里打开本工程后点「自动签名」（需登录华为开发者账号），
    // 或手动填 signingConfigs；未签名时 hvigor 仍会产出 unsigned HAP（可编译、不可安装）。
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        // API 26+ 的格式是纯版本字符串 "26.0.0"（不带括号；API 10–25 才是 '5.0.0(12)' 那种）。
        // 本机只装了 API 26 的 SDK；想覆盖更多机型需先在 DevEco SDK Manager 里装更低版本，再降这里并同步核对。
        "targetSdkVersion": "26.0.0",
        "compatibleSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
