backend/.venv
**/__pycache__
**/*.py[cod]
**/*.egg-info
.pytest_cache
.ruff_cache

# 本地数据与日志
*.db
*.sqlite
*.sqlite3
.dev-logs
*.log

# 环境变量不进入镜像
.env
.env.*
