# ────────────────────────────────────────────────────────────────
# 本地开发环境（无 Docker）。复制为 .env.local 后按需修改。
#   cp .env.local.example .env.local
# ────────────────────────────────────────────────────────────────

# 服务端口
BACKEND_PORT=8000
FRONTEND_PORT=5173

# 数据库：本地默认用 SQLite，无需任何外部依赖。
# 若本机已装 PostgreSQL，可改为：
#   DATABASE_URL=postgresql+asyncpg://eorzea:eorzea@localhost:5432/eorzea
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# JWT 密钥（至少 32 位，生产环境务必更换）
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_EXPIRE_HOURS=24

# 上报校验容差（击杀速率允许的超额比例）
REPORT_TOLERANCE=1.10

# ── 兑换码（本地自测可留空关闭）──
# 每个账号对同一兑换码只能兑换一次。
REDEEM_CODE=
REDEEM_GOLD=0

# ── 管理员（本地自测可留空关闭）──
# 留空 ADMIN_PASSWORD 即不创建管理员账号。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 是否在启动时自动建表（本地开发建议 true，配合 SQLite 免迁移）
AUTO_CREATE_TABLES=true

# ── 并发降载（本地按默认即可）──
# 本地 dev.sh 为单进程，排行榜刷新仍由 API 进程承担；生产改由 ranking-worker 独立进程。
RANKING_IN_API=true
# 本地不跑 ranking-worker（dev.sh 只启 coop / worldboss worker），保留清理不会触发；
# 这里显式关闭，避免手动起 ranking_worker 时误删本地测试数据。
RETENTION_ENABLED=false
# 响应体压缩（直连 API 时生效）
GZIP_ENABLED=true
# 响应 brotli（客户端支持 br 时优先，gzip 兜底）与请求体 gzip 解压
BROTLI_ENABLED=true
REQUEST_DECOMPRESS_ENABLED=true
# 世界BOSS 客户端上报的伤害上限容差（越大越宽松）
WORLDBOSS_REPORT_TOLERANCE=1.15

# ── 依赖下载源（安装前后端依赖时使用）──
# 默认走国内镜像；改为官方源即 PIP_INDEX_URL=https://pypi.org/simple、
# NPM_REGISTRY=https://registry.npmjs.org。留空则该次安装沿用系统默认配置。
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com
