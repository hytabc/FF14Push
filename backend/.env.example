# 后端环境变量（手动启动/容器部署时使用）
#
# 本地一键脚本 ./scripts/dev.sh 会自行注入这些变量，无需手动创建本文件。
# 服务器部署请使用仓库根目录的 .env（见 .env.example）。

# 数据库
# 本地 SQLite：sqlite+aiosqlite:///./dev.db
# 生产 PostgreSQL：postgresql+asyncpg://用户:密码@主机:5432/库名
DATABASE_URL=postgresql+asyncpg://eorzea:eorzea@localhost:5432/eorzea

# JWT（密钥至少 32 位，生产务必替换：openssl rand -hex 32）
JWT_SECRET=please-change-this-to-a-random-32-byte-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# CORS：允许直接访问后端的来源，逗号分隔
CORS_ORIGINS=http://localhost:5173

# 启动时自动建表。
# 本地开发可设 true（免迁移）；生产请保持 false 并执行 alembic upgrade head
AUTO_CREATE_TABLES=true

# 上报校验容差（击杀速率等允许的最大超出比例）
REPORT_TOLERANCE=1.10
