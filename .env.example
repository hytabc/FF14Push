# ────────────────────────────────────────────────────────────────
# 服务器部署环境（docker compose 会自动读取本目录下的 .env）
#   cp .env.example .env && 修改后执行 docker compose up -d --build
# ────────────────────────────────────────────────────────────────

# ── 对外端口 ──
# 前端（nginx，唯一需要公网暴露的端口）
FRONTEND_PORT=19999
# 后端 API（默认只绑定 127.0.0.1；如需直接对外，见 docker-compose.yml 注释）
BACKEND_PORT=8000
# PostgreSQL（默认只绑定 127.0.0.1）
POSTGRES_PORT=5432

# ── 数据库 ──
POSTGRES_USER=eorzea
POSTGRES_PASSWORD=please-change-this-password
POSTGRES_DB=eorzea

# 数据库文件在本机磁盘上的存放目录（bind mount）。
# 数据随实例重建 / 更新保留；也可以直接备份该目录。
POSTGRES_DATA_DIR=./data/postgres

# ── 自动备份（db-backup 服务）──
# 备份产物存放目录（bind mount 到容器内 /backups）。
BACKUP_DIR=./data/backups
# 备份间隔（小时）。
BACKUP_INTERVAL_HOURS=6
# 只保留最近几份压缩包，更旧的自动清理（<=0 表示不清理）。
BACKUP_KEEP=7
# 压缩包文件名前缀，形如 eorzea-20260924-120000.tar.gz。
BACKUP_PREFIX=eorzea

# ── 应用 ──
# JWT 密钥，务必替换为随机值（至少 32 位）：
#   openssl rand -hex 32
JWT_SECRET=please-change-this-to-a-random-32-byte-secret
JWT_EXPIRE_HOURS=24

# 允许的前端来源（浏览器直接访问后端的场景）。
# 使用自带的 nginx 反代时前后端同源，此处保持与前端访问地址一致即可。
CORS_ORIGINS=http://localhost:8080

# 上报校验容差
REPORT_TOLERANCE=1.10

# ── 并发降载（可选）──
# uvicorn 工作进程数：大量玩家同时挂机时单进程会让请求排队，默认 2。
UVICORN_WORKERS=2
# 后端 API 的 PostgreSQL 连接池（默认 pool_size=10 + max_overflow=20 = 最多 30 条连接）。
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# 响应体压缩：直连后端（未经 nginx）时对超过 1KB 的响应启用 gzip，默认开启。
GZIP_ENABLED=true
# 后端走 HTTPS 时设为 true，使设备 Cookie 只在 HTTPS 下发送。
COOKIE_SECURE=true

# ── 兑换码 ──
# 兑换码与可领取的金币数量。REDEEM_CODE 留空即关闭「设置 → 兑换码」入口。
# 每个账号对同一兑换码只能兑换一次；更换兑换码后，所有账号可再次兑换新码。
REDEEM_CODE=FF14
REDEEM_GOLD=1000000

# ── 管理员 ──
# 管理员账号名与密码。ADMIN_PASSWORD 留空即不启用管理员。
# 启动时按此配置创建/同步该账号（改密码后重启即生效）；管理员不参与排行榜。
# 管理员登录后可在「管理」页搜索用户并重置其密码（用于玩家忘记密码）。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── 国内镜像源（仅在构建镜像时使用）──
# 留空即回退官方源（例如服务器已配置 /etc/docker/daemon.json registry-mirrors 时，
# 把 DOCKER_IMAGE_MIRROR 设为空即可让镜像名回到 postgres:16-alpine 这种官方写法）。
#
# Docker Hub 加速前缀（官方 library/ 镜像；末尾斜杠要保留）
DOCKER_IMAGE_MIRROR=docker.m.daocloud.io/library/
# pip 索引（Python 依赖）
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# npm 源（前端依赖）
NPM_REGISTRY=https://registry.npmmirror.com
# Debian apt 源域名（后端镜像里装 curl 用）
APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
